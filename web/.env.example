# Copy to .env.local for local development. In production, set these in Vercel (or your host).

# Where Next.js proxies /api/* to (the Rails API). Server-side only.
API_ORIGIN=http://localhost:3001

# The Action Cable socket the big screen, cockpit and phones connect to.
# Unset, it falls back to ws(s)://<this host>:3001/cable, which only works locally.
NEXT_PUBLIC_CABLE_URL=ws://localhost:3001/cable

# The address printed in room QR codes. Unset, it uses the current origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Website pages built but hidden at launch (tech spec 3.2). "true" turns one on.
NEXT_PUBLIC_SHOW_PRICING=false
NEXT_PUBLIC_SHOW_EXPLORE=false
